{
  "name": "ding-frame",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Ephemeral small-video analysis with frame extraction and ASR.",
  "scripts": {
    "dev": "concurrently -k \"tsx watch src/server/index.js\" \"vite\"",
    "build": "npm run build:client",
    "build:client": "vite build",
    "start": "node src/server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm test && npm run build"
  },
  "dependencies": {
    "@fastify/multipart": "^9.2.1",
    "@fastify/static": "^10.1.3",
    "ali-oss": "^6.23.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.5.0",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.3",
    "vite": "^7.1.2",
    "vitest": "^3.2.4"
  }
}
