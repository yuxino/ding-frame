PORT=3000
MAX_UPLOAD_BYTES=524288000
MAX_DURATION_SECONDS=900
# 关键帧宽度（保持比例缩放）；更大更清晰，也会增加存储和 API 流量
FRAME_WIDTH=1280
# 场景检测阈值 0–1：画面变化超过它才作为“转场/重点”帧优先保留；越小抓的越多
FRAME_SCENE_THRESHOLD=0.4
# 关键帧数量上限：场景帧 + 均匀补足帧合计不超过这个数
MAX_FRAMES=18
# 一次交给视觉模型理解的代表帧数上限（从全部关键帧里再挑选）
VISION_MAX_FRAMES=10
# 喂给视觉模型的听写文本上限（字符）；过长时保留头尾、中间省略
VISION_TRANSCRIPT_CHARS=30000
# 视觉模型输出上限（tokens）；章节总结输出量较大，太低会导致 JSON 被截断
VISION_MAX_TOKENS=2000
# 同时运行的分析任务数上限；超出时排队等待，避免资源被多个大视频占满
MAX_CONCURRENT_JOBS=2
RESULT_TTL_SECONDS=1200

# 接入阿里云百炼时改为 dashscope；声明了真实 provider 但没有 key 时自动回退演示数据
ASR_PROVIDER=dashscope
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
# 可选；留空时会根据 Workspace ID 生成北京地域地址，再回退到公共兼容地址
DASHSCOPE_BASE_URL=
ASR_MODEL=qwen3-asr-flash
ASR_SEGMENT_SECONDS=60
ASR_MAX_SEGMENT_BYTES=8388608
DASHSCOPE_TIMEOUT_MS=120000

# 配置后会把抽帧和听写交给阿里云百炼视觉模型；缺 key 时自动回退演示数据
ANALYSIS_PROVIDER=openai-compatible
# 留空时自动复用 DASHSCOPE_API_KEY
VISION_API_KEY=
VISION_BASE_URL=
VISION_MODEL=qwen3-vl-flash

# 字幕级听写使用同步 Fun-ASR-Flash（base64 直传，无需公网地址）
# 说话人分离使用异步 Fun-ASR，需要服务有公网地址：
# 配置 PUBLIC_BASE_URL 后自动开启，也可以用 ASR_DIARIZATION=on/off 强制指定
# ASR_MODEL=fun-asr-flash-2026-06-15
# PUBLIC_BASE_URL=
# ASR_DIARIZATION=auto
