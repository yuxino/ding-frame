PORT=3000
MAX_UPLOAD_BYTES=524288000
MAX_DURATION_SECONDS=900
FRAME_INTERVAL_SECONDS=6
MAX_FRAMES=12
RESULT_TTL_SECONDS=1200

# 默认 mock，先让前端流程跑通；接入阿里云百炼时改为 dashscope
ASR_PROVIDER=dashscope
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
# 可选；留空时会根据 Workspace ID 生成北京地域地址，再回退到公共兼容地址
DASHSCOPE_BASE_URL=
ASR_MODEL=qwen3-asr-flash
ASR_SEGMENT_SECONDS=60
ASR_MAX_SEGMENT_BYTES=8388608
DASHSCOPE_TIMEOUT_MS=120000

# 默认 mock；配置后会把抽帧和听写交给阿里云百炼视觉模型
ANALYSIS_PROVIDER=openai-compatible
# 留空时自动复用 DASHSCOPE_API_KEY
VISION_API_KEY=
VISION_BASE_URL=
VISION_MODEL=qwen3-vl-flash
