PORT=3000
MAX_UPLOAD_BYTES=524288000
MAX_DURATION_SECONDS=900
FRAME_WIDTH=1280
FRAME_SCENE_THRESHOLD=0.4
MAX_FRAMES=18
VISION_MAX_FRAMES=10
VISION_TRANSCRIPT_CHARS=30000
VISION_MAX_TOKENS=2000
MAX_CONCURRENT_JOBS=2
RESULT_TTL_SECONDS=1200
AI_TIMEOUT_MS=120000

# ASR providers: mock | dashscope | groq | openai | openai-compatible
ASR_PROVIDER=mock
ASR_MODEL=
# Only needed for openai-compatible or to override a preset:
ASR_API_KEY=
ASR_BASE_URL=
ASR_SEGMENT_SECONDS=60
ASR_MAX_SEGMENT_BYTES=8388608

# Vision providers: mock | dashscope | openai | gemini | openrouter | groq | openai-compatible
VISION_PROVIDER=mock
VISION_MODEL=
# Only needed for openai-compatible or to override a preset:
VISION_API_KEY=
VISION_BASE_URL=

# Preset credentials. Koma selects the matching key from ASR_PROVIDER / VISION_PROVIDER.
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
DASHSCOPE_BASE_URL=
GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Speaker diarization currently uses DashScope's async Fun-ASR endpoint.
# PUBLIC_BASE_URL makes its temporary audio URL reachable by DashScope.
PUBLIC_BASE_URL=
ASR_DIARIZATION=off

# Optional guardrails for a small public demo. Set TRUST_PROXY=true behind nginx.
TRUST_PROXY=false
# 0 disables the built-in single-node daily limit.
DEMO_REQUESTS_PER_IP_PER_DAY=0
